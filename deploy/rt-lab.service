[Unit]
Description=RT Lab Next.js application
Documentation=https://rt.moris.dev
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mortafix
WorkingDirectory=/home/mortafix/coding/rt/current
EnvironmentFile=/home/mortafix/coding/rt/.env.current
ExecStart=/usr/bin/node /home/mortafix/coding/rt/current/.next/standalone/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rt-lab

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=false
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
