# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=rt_lab

# URL pubblico esatto, senza slash finale
APP_URL=https://rt.moris.dev

# Generare valori casuali indipendenti di almeno 32 byte.
# Esempio: openssl rand -base64 48
AUTH_PEPPER=replace-with-a-random-secret-at-least-32-characters
SESSION_PEPPER=replace-with-another-random-secret-at-least-32-characters

# Esattamente 32 byte in base64 oppure 64 caratteri esadecimali.
# Esempio: openssl rand -base64 32
CODE_ENCRYPTION_KEY=replace-with-a-32-byte-base64-or-64-char-hex-key

NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000
